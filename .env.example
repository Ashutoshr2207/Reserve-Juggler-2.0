# Reserve Juggler Environment Configuration Example
# Copy this file to .env and configure for your local or production environment.
# Never commit real credentials or .env files to source control.

# MongoDB connection settings (Atlas or local deployment)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=reserve_juggler

# Application environment: 'development' or 'production'
APP_ENV=development

# Cookie security: true forces Secure attribute on cookies (recommended for HTTPS/production)
# If not set, defaults to true in production, false in development
SECURE_COOKIES=false

# Session lifetime in seconds (default: 30 days = 2592000 seconds)
AUTH_SESSION_LIFETIME_SECONDS=2592000

# Optional Treasury Assistant AI configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TREASURY_ASSISTANT_TIMEOUT=30
